    </EditText>


    <Button
        android:layout_width=""
        android:layout_height="">


    </Button>

    <TextView
        android:layout_width=""
        android:layout_height="">

    </TextView>

    <Button
        android:layout_width=""
        android:layout_height="">



    </Button>


    
    
    
    
    
    

</androidx.constraintlayout.widget.ConstraintLayout>