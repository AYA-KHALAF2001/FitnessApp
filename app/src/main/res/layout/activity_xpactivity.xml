<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@drawable/background">


    <TextView
        android:id="@+id/xpTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="XP Overview"
        android:textStyle="bold"
        android:textSize="32sp"
        android:textColor="#000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp"/>


    <TextView
        android:id="@+id/xpLevelText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Level 1"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/xpTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="25dp"/>


    <ProgressBar
        android:id="@+id/xpProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="250dp"
        android:layout_height="25dp"
        android:progress="0"
        android:max="100"
        app:layout_constraintTop_toBottomOf="@id/xpLevelText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />


    <TextView
        android:id="@+id/xpValueText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 / 100 XP"
        android:textSize="18sp"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/xpProgressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"/>


    <TextView
        android:id="@+id/xpStreakText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current Streak: 0 days"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FF3700B3"
        app:layout_constraintTop_toBottomOf="@id/xpValueText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="35dp"/>

    <TextView
        android:id="@+id/xpRankText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rank: Starter"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/xpStreakText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="25dp"/>

    <LinearLayout
        android:id="@+id/rankStarterRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/xpRankText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp">

        <ImageView
            android:id="@+id/rankStarterIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/rank_starter"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/rankStarter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Starter — Levels 1–4"
            android:textSize="18sp"
            android:textColor="#000000"/>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/rankCrewRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/rankStarterRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp">

        <ImageView
            android:id="@+id/rankCrewIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/rank_crew"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/rankCrew"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crew — Levels 5–9"
            android:textSize="18sp"
            android:textColor="#000000"/>
    </LinearLayout>



    <LinearLayout
        android:id="@+id/rankEliteRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/rankCrewRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp">

        <ImageView
            android:id="@+id/rankEliteIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/rank_elite"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/rankElite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Elite — Levels 10–14"
            android:textSize="18sp"
            android:textColor="#000000"/>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/rankPrestigeRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/rankEliteRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp">

        <ImageView
            android:id="@+id/rankPrestigeIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/rank_prestige"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/rankPrestige"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prestige — Levels 15–19"
            android:textSize="18sp"
            android:textColor="#000000"/>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/rankLeaderRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/rankPrestigeRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp">

        <ImageView
            android:id="@+id/rankLeaderIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/rank_leader"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/rankLeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Leader — Level 20+"
            android:textSize="18sp"
            android:textColor="#000000"/>
    </LinearLayout>





</androidx.constraintlayout.widget.ConstraintLayout>
