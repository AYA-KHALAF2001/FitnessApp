<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:textStyle="bold"
    android:background="#FFFFFF">

    <!-- Title -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fitness Tracker"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#444444" />

    <!-- Current Streak Display -->
    <TextView
        android:id="@+id/streakText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current Streak: 0 days"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FF3700B3"
        android:layout_marginBottom="20dp"/>

    <!-- Workout Log Button -->
    <Button
        android:id="@+id/workoutBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WORKOUT LOG"
        android:textAllCaps="true"
        android:layout_marginBottom="16dp"
        android:textColor="#FFBB86FC"
        android:textStyle="bold" />

    <!-- Recipes Button -->
    <Button
        android:id="@+id/recipesBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RECIPES"
        android:textAllCaps="true"
        android:layout_marginBottom="16dp"
        android:textColor="#FF018786"
        android:textStyle="bold" />

    <!-- Progress Tracker Button -->
    <Button
        android:id="@+id/progressBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PROGRESS TRACKER"
        android:textAllCaps="true"
        android:layout_marginBottom="16dp"
        android:textStyle="bold" />

</LinearLayout>